<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Canonical non-www Redirection (www.goloholidays.com to goloholidays.com)
  RewriteCond %{HTTP_HOST} ^www\.goloholidays\.com$ [NC]
  RewriteRule ^(.*)$ https://goloholidays.com/$1 [R=301,L]

  # 2. HTTPS Redirection (secure connections)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. SPA Routing Support: If the requested resource exists, serve it
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^ - [L]

  # Otherwise, route all paths to index.html for Angular to handle
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Leverage Browser Caching (Speed & SEO optimization)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Do not cache dynamic configs or index.html (so new builds load immediately)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  
  # Cache media assets, fonts, css, and js (which use hashes in Angular) for 1 year
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
